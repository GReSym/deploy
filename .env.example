# Generated by ./manage.sh setup into .env (git-ignored).
# Values come from ../backend/config.json (DB, RabbitMQ, JWT) and ../ml/config.json (read-only DB user);
# MARIADB_ROOT_PASSWORD is generated once and kept. Values are single-quoted literals.
MARIADB_ROOT_PASSWORD='xxx'
DB_NAME='GamesRecommend'
DB_PORT='3306'
DB_USER='xxx'
DB_PASSWORD='xxx'
DB_READONLY_USER='xxx'
DB_READONLY_PASSWORD='xxx'
RABBITMQ_USER='xxx'
RABBITMQ_PASSWORD='xxx'
JWT_KEY='xxx'
JWT_EXPIRE_MINUTES='60'
# Connection string for the API container (Server=mariadb)
API_DB_CONNECTION='xxx'
# PyTorch build for the ML image: cpu (default) | rocm (AMD) | cuda (NVIDIA). Change with
# `TORCH_BACKEND=rocm ./manage.sh setup`, then `./manage.sh up --app` rebuilds the image.
TORCH_BACKEND='cpu'
# Empty for cpu (uv.lock). rocm/cuda default to the PyTorch nightly indexes (see manage.sh)
TORCH_INDEX_URL=''
# Model dtype on a GPU (CPU always uses config.example.json: float32)
ML_MODEL_DTYPE='bfloat16'
# Host groups for ROCm device access (/dev/kfd, /dev/dri)
VIDEO_GID=''
RENDER_GID=''
